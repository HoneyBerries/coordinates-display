{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${description}",
  "authors": [ "${mod_author}" ],
  "contact": {},

  "license": "${license}",
  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.boxadactle.coordinatesdisplay.fabric.CoordinatesDisplayFabric"
    ],
    "client": [
      "dev.boxadactle.boxlib.fabric.BoxLibFabric"
    ],
    "modmenu": [
      "dev.boxadactle.coordinatesdisplay.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "coordinatesdisplay.mixins.json",
    "boxlib.mixins.json",
    "boxlib-common.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": "${minecraft_version_range_fabric}"
  },
  "breaks": {
    "boxlib": "*"
  }
}
